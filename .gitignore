# ── 비밀값 (절대 커밋 금지) ──────────────────────────────────────────────────
.env
settings.json
!config/settings.json.template

# ── 개인 색인 데이터 (사용자마다 다름, 커밋 대상 아님) ───────────────────────
rag_index.db
rag_index_b.db
rag_index.db-shm
rag_index.db-wal
rag_index_b.db-shm
rag_index_b.db-wal
rag_index.npz
rag_index.active
rag_index_b.active
.ragignore
indexer_config.json
indexer_status.json
bak_db/

# ── 대용량 바이너리 (배포 스크립트가 별도로 받아오는 것들, git엔 안 올림) ────
python/*
!python/.gitkeep
models/*.gguf
!models/.gitkeep

# ── 빌드 산출물 ──────────────────────────────────────────────────────────────
# bin/<name>/ (PyInstaller --onedir 산출 exe+_internal) 및 bin/config/(config/
# 폴더를 배포용으로 복사한 사본, 재생성 가능 — 패키징 시 config/*를 여기로
# 복사하는 과정이 필요함, 아직 스크립트화 안 됨)는 전부 재생성 가능하므로 미커밋
bin/*.exe
bin/*/
build/
dist/
*.spec

# 설치 프로그램 산출물 (build_installer.ps1로 재생성 가능, 실제 배포는
# GitHub Releases로 — 저장소에는 .iss/빌드 스크립트만 커밋)
installer/output/
installer/staging/

# tray-src(C++/MFC) 빌드 산출물 — build.bat로 재생성 가능
tray-src/tray.exe
tray-src/tray.exe.manifest

# [정보탭_버전관리] gen_version_file.py/gen_version_h.py가 app_paths.py의
# NOTEBOOKRAG_VERSION으로부터 빌드 시점에 재생성하는 산출물 — 미커밋
src/version_info_notebookrag.txt
src/version_info_mcprag.txt
tray-src/src/version.h
*.obj
*.pdb
*.res
*.ilk

# ── 파이썬 표준 ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── 테스트/스크래치 산출물 (개발 원본에서 옮겨오지 않게 주의) ────────────────
test_*.py
*.bak-*
_e2e_scratch*/
*.log

# ── 내부 개발 기록 (공개 저장소 부적합 — 별도 보관) ──────────────────────────
README_RELEASE.md
업무지침_*.md

# ── OS/에디터 잡동사니 ────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
*.swp
